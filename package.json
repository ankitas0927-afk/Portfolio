{
  "name": "ankita-portfolio",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build:packages": "pnpm --filter @ankita-portfolio/config build && pnpm --filter @ankita-portfolio/shared-types build && pnpm --filter @ankita-portfolio/validation build",
    "dev": "pnpm build:packages && pnpm --filter @ankita-portfolio/web dev",
    "dev:api": "pnpm build:packages && pnpm --filter @ankita-portfolio/api dev",
    "dev:web": "pnpm build:packages && pnpm --filter @ankita-portfolio/web dev",
    "build": "pnpm build:packages && pnpm --filter @ankita-portfolio/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "test": "pnpm build:packages && pnpm -r test",
    "test:e2e": "pnpm --filter @ankita-portfolio/web test:e2e",
    "seed": "pnpm build:packages && pnpm --filter @ankita-portfolio/api seed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@next/eslint-plugin-next": "^15.4.6",
    "@types/node": "^24.2.1",
    "concurrently": "^9.2.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ],
    "*.{js,jsx,ts,tsx,json,md,css}": [
      "prettier --write"
    ]
  }
}
